.................... // Read 16-bit Temperature from TMP117 
.................... float tmp117_read_temperature(void) { 
*
0220:  CLRF   09
0222:  CLRF   0A
0224:  CLRF   0C
0226:  CLRF   0B
0228:  CLRF   10
022A:  CLRF   0F
022C:  CLRF   0E
022E:  CLRF   0D
....................    int8 msb = 0, lsb = 0; 
....................    signed int16 raw_temp = 0; 
....................    float celsius = 0.0; 
....................     
....................    i2c_start(); 
0230:  BSF    FC5.0
0232:  BTFSC  FC5.0
0234:  BRA    0232
....................    i2c_write(TMP117_ADDR_WRITE); 
0236:  MOVLW  90
0238:  MOVWF  11
023A:  RCALL  00AA
....................    i2c_write(TMP117_REG_TEMP); 
023C:  CLRF   11
023E:  RCALL  00AA
....................    i2c_start(); 
0240:  BSF    FC5.1
0242:  BTFSC  FC5.1
0244:  BRA    0242
....................    i2c_write(TMP117_ADDR_READ); 
0246:  MOVLW  91
0248:  MOVWF  11
024A:  RCALL  00AA
....................    msb = i2c_read(1); // ACK 
024C:  MOVLW  01
024E:  MOVWF  00
0250:  RCALL  00C6
0252:  MOVFF  01,09
....................    lsb = i2c_read(0); // NACK 
0256:  CLRF   00
0258:  RCALL  00C6
025A:  MOVFF  01,0A
....................    i2c_stop(); 
025E:  BSF    FC5.2
0260:  BTFSC  FC5.2
0262:  BRA    0260
....................     
....................    raw_temp = make16(msb, lsb); 
0264:  MOVFF  09,0C
0268:  MOVFF  0A,0B
....................    // 1 LSB = 0.0078125 Â°C (or raw_temp / 128.0) 
....................    celsius = (float)raw_temp * 0.0078125; 
026C:  MOVFF  0C,12
0270:  MOVFF  0B,11
0274:  BRA    00E2
0276:  MOVFF  03,14
027A:  MOVFF  02,13
027E:  MOVFF  01,12
0282:  MOVFF  00,11
0286:  MOVFF  03,18
028A:  MOVFF  02,17
028E:  MOVFF  01,16
0292:  MOVFF  00,15
0296:  CLRF   1C
0298:  CLRF   1B
029A:  CLRF   1A
029C:  MOVLW  78
029E:  MOVWF  19
02A0:  BRA    012C
02A2:  MOVFF  03,10
02A6:  MOVFF  02,0F
02AA:  MOVFF  01,0E
02AE:  MOVFF  00,0D
....................     
....................    return celsius; 
02B2:  MOVFF  0D,00
02B6:  MOVFF  0E,01
02BA:  MOVFF  0F,02
02BE:  MOVFF  10,03
02C2:  GOTO   0306 (RETURN)
.................... } 
