.................... // Low-level SPI helper for ST7735 
.................... void st7735_write_cmd(int8 cmd) { 
....................    output_low(ST7735_DC); 
*
003A:  BCF    F94.2
003C:  BCF    F8B.2
....................    output_low(ST7735_CS); 
003E:  BCF    F94.0
0040:  BCF    F8B.0
....................    spi_xfer(SPI_TFT, cmd); 
0042:  MOVFF  09,0A
0046:  RCALL  002A
....................    output_high(ST7735_CS); 
0048:  BCF    F94.0
004A:  BSF    F8B.0
004C:  RETURN 0
.................... } 
....................  
.................... void st7735_write_data(int8 data) { 
....................    output_high(ST7735_DC); 
004E:  BCF    F94.2
0050:  BSF    F8B.2
....................    output_low(ST7735_CS); 
0052:  BCF    F94.0
0054:  BCF    F8B.0
....................    spi_xfer(SPI_TFT, data); 
0056:  MOVFF  09,0A
005A:  RCALL  002A
....................    output_high(ST7735_CS); 
005C:  BCF    F94.0
005E:  BSF    F8B.0
0060:  GOTO   00A0 (RETURN)
.................... } 
....................  
.................... void st7735_init(void) { 
....................    output_high(ST7735_CS); 
0064:  BCF    F94.0
0066:  BSF    F8B.0
....................    output_low(ST7735_RST); 
0068:  BCF    F94.1
006A:  BCF    F8B.1
....................    delay_ms(50); 
006C:  MOVLW  32
006E:  MOVWF  0A
0070:  RCALL  0004
....................    output_high(ST7735_RST); 
0072:  BCF    F94.1
0074:  BSF    F8B.1
....................    delay_ms(50); 
0076:  MOVLW  32
0078:  MOVWF  0A
007A:  RCALL  0004
....................     
....................    st7735_write_cmd(0x01); // SWRESET (Software Reset) 
007C:  MOVLW  01
007E:  MOVWF  09
0080:  RCALL  003A
....................    delay_ms(150); 
0082:  MOVLW  96
0084:  MOVWF  0A
0086:  RCALL  0004
....................    st7735_write_cmd(0x11); // SLPOUT (Exit Sleep) 
0088:  MOVLW  11
008A:  MOVWF  09
008C:  RCALL  003A
....................    delay_ms(120); 
008E:  MOVLW  78
0090:  MOVWF  0A
0092:  RCALL  0004
....................    st7735_write_cmd(0x3A); // COLMOD (Color Format) 
0094:  MOVLW  3A
0096:  MOVWF  09
0098:  RCALL  003A
....................    st7735_write_data(0x05); // 16-bit/pixel (RGB565) 
009A:  MOVLW  05
009C:  MOVWF  09
009E:  BRA    004E
....................    st7735_write_cmd(0x29); // DISPON (Display On) 
00A0:  MOVLW  29
00A2:  MOVWF  09
00A4:  RCALL  003A
00A6:  GOTO   0304 (RETURN)
.................... } 

