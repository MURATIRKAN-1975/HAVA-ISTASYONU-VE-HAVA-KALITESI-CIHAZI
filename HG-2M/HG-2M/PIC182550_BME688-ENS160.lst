....................    delay_ms(50); 
033E:  MOVLW  32
0340:  MOVWF  2E
0342:  RCALL  004A
0344:  GOTO   127A (RETURN)
.................... } 
....................  
.................... void ens160_read_data() { 
....................    unsigned int8 buf[5]; 
....................    // 0x21 (AQI), 0x22-0x23 (TVOC), 0x24-0x25 (eCO2) ardışık okunur 
....................    i2c_read_bytes(ENS160_ADDR_W, ENS160_REG_DATA_AQI, buf, 5); 
*
0480:  MOVLW  A6
0482:  MOVWF  2E
0484:  MOVLW  21
0486:  MOVWF  2F
0488:  CLRF   31
048A:  MOVLW  16
048C:  MOVWF  30
048E:  MOVLW  05
0490:  MOVWF  32
0492:  RCALL  0390
....................     
....................    aqi  = buf[0] & 0x07; // İlk 3 bit AQI (1-5 arası) 
0494:  MOVF   16,W
0496:  ANDLW  07
0498:  MOVWF  04
....................    tvoc = make16(buf[2], buf[1]); // Little Endian 
049A:  MOVFF  18,06
049E:  MOVFF  17,05
....................    eco2 = make16(buf[4], buf[3]); // Little Endian 
04A2:  MOVFF  1A,08
04A6:  MOVFF  19,07
04AA:  GOTO   1292 (RETURN)
.................... } 
