.................... // --- ENS160 Başlatma ve Okuma --- 
.................... void ens160_init() { 
....................    delay_ms(50); 
*
032A:  MOVLW  32
032C:  MOVWF  2E
032E:  RCALL  004A
....................    i2c_write_reg(ENS160_ADDR_W, ENS160_REG_OPMODE, ENS160_OPMODE_STD); 
