....................  
.................... #ifndef __LCD_C__ 
.................... #define __LCD_C__ 
....................  
.................... // define the pinout. 
.................... // only required if port access is being used. 
.................... typedef struct   
.................... {                            // This structure is overlayed 
....................    int1 enable;           // on to an I/O port to gain 
....................    int1 rs;               // access to the LCD pins. 
....................    int1 rw;               // The bits are allocated from 
....................    int1 unused;           // low order up.  ENABLE will 
....................    unsigned int     data : 4;         // be LSB pin of that port. 
....................   #if defined(__PCD__)       // The port used will be LCD_DATA_PORT. 
....................    unsigned int    reserved: 8; 
....................   #endif 
.................... } LCD_PIN_MAP; 
....................  
.................... // this is to improve compatability with previous LCD drivers that accepted 
.................... // a define labeled 'use_portb_lcd' that configured the LCD onto port B. 
.................... #if ((defined(use_portb_lcd)) && (use_portb_lcd==TRUE)) 
....................  #define LCD_DATA_PORT getenv("SFR:PORTB") 
.................... #endif 
....................  
.................... #if defined(__PCB__) 
....................    // these definitions only need to be modified for baseline PICs. 
....................    // all other PICs use LCD_PIN_MAP or individual LCD_xxx pin definitions. 
.................... /*                                    EN, RS,   RW,   UNUSED,  DATA  */ 
....................  const LCD_PIN_MAP LCD_OUTPUT_MAP =  {0,  0,    0,    0,       0}; 
....................  const LCD_PIN_MAP LCD_INPUT_MAP =   {0,  0,    0,    0,       0xF}; 
.................... #endif 
....................  
.................... ////////////////////// END CONFIGURATION /////////////////////////////////// 
....................  
.................... #ifndef LCD_ENABLE_PIN 
....................    #define lcd_output_enable(x) lcdlat.enable=x 
....................    #define lcd_enable_tris()   lcdtris.enable=0 
.................... #else 
....................    #define lcd_output_enable(x) output_bit(LCD_ENABLE_PIN, x) 
....................    #define lcd_enable_tris()  output_drive(LCD_ENABLE_PIN) 
.................... #endif 
....................  
.................... #ifndef LCD_RS_PIN 
....................    #define lcd_output_rs(x) lcdlat.rs=x 
....................    #define lcd_rs_tris()   lcdtris.rs=0 
.................... #else 
....................    #define lcd_output_rs(x) output_bit(LCD_RS_PIN, x) 
....................    #define lcd_rs_tris()  output_drive(LCD_RS_PIN) 
.................... #endif 
....................  
.................... #ifndef LCD_RW_PIN 
....................    #define lcd_output_rw(x) lcdlat.rw=x 
....................    #define lcd_rw_tris()   lcdtris.rw=0 
.................... #else 
....................    #define lcd_output_rw(x) output_bit(LCD_RW_PIN, x) 
....................    #define lcd_rw_tris()  output_drive(LCD_RW_PIN) 
.................... #endif 
....................  
.................... // original version of this library incorrectly labeled LCD_DATA0 as LCD_DATA4, 
.................... // LCD_DATA1 as LCD_DATA5, and so on.  this block of code makes the driver 
.................... // compatible with any code written for the original library 
.................... #if (defined(LCD_DATA0) && defined(LCD_DATA1) && defined(LCD_DATA2) && defined(LCD_DATA3) && !defined(LCD_DATA4) && !defined(LCD_DATA5) && !defined(LCD_DATA6) && !defined(LCD_DATA7)) 
....................    #define  LCD_DATA4    LCD_DATA0 
....................    #define  LCD_DATA5    LCD_DATA1 
....................    #define  LCD_DATA6    LCD_DATA2 
....................    #define  LCD_DATA7    LCD_DATA3 
.................... #endif 
....................  
.................... #ifndef LCD_DATA4 
.................... #ifndef LCD_DATA_PORT 
....................    #if defined(__PCB__) 
....................       #define LCD_DATA_PORT      0x06     //portb 
....................       #define set_tris_lcd(x)   set_tris_b(x) 
....................    #else 
....................      #if defined(PIN_D0) 
....................       #define LCD_DATA_PORT      getenv("SFR:PORTD")     //portd 
....................      #else 
....................       #define LCD_DATA_PORT      getenv("SFR:PORTB")     //portb 
....................      #endif 
....................    #endif    
.................... #endif 
....................  
.................... #if defined(__PCB__) 
....................    LCD_PIN_MAP lcd, lcdlat; 
....................    #byte lcd = LCD_DATA_PORT 
....................    #byte lcdlat = LCD_DATA_PORT 
.................... #elif defined(__PCM__) 
....................    LCD_PIN_MAP lcd, lcdlat, lcdtris; 
....................    #byte lcd = LCD_DATA_PORT 
....................    #byte lcdlat = LCD_DATA_PORT 
....................    #byte lcdtris = LCD_DATA_PORT+0x80 
.................... #elif defined(__PCH__) 
....................    LCD_PIN_MAP lcd, lcdlat, lcdtris; 
....................    #byte lcd = LCD_DATA_PORT 
....................    #byte lcdlat = LCD_DATA_PORT+9 
....................    #byte lcdtris = LCD_DATA_PORT+0x12 
.................... #elif defined(__PCD__) 
....................    LCD_PIN_MAP lcd, lcdlat, lcdtris; 
....................    #word lcd = LCD_DATA_PORT 
....................    #word lcdlat = LCD_DATA_PORT+2 
....................    #word lcdtris = LCD_DATA_PORT-0x02 
.................... #endif 
.................... #endif   //LCD_DATA4 not defined 
....................  
.................... #ifndef LCD_TYPE 
....................    #define LCD_TYPE 2           // 0=5x7, 1=5x10, 2=2 lines 
.................... #endif 
....................  
.................... #ifndef LCD_LINE_TWO 
....................    #define LCD_LINE_TWO 0x40    // LCD RAM address for the second line 
.................... #endif 
....................  
.................... #ifndef LCD_LINE_LENGTH 
....................    #define LCD_LINE_LENGTH 20 
.................... #endif 
....................  
.................... unsigned int8 lcd_read_nibble(void); 
....................  
.................... unsigned int8 lcd_read_byte(void) 
.................... { 
....................    unsigned int8 low,high; 
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_INPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_float(LCD_DATA4); 
*
0106:  BSF    F93.4
....................    output_float(LCD_DATA5); 
0108:  BSF    F93.5
....................    output_float(LCD_DATA6); 
010A:  BSF    F93.6
....................    output_float(LCD_DATA7); 
010C:  BSF    F93.7
....................   #else 
....................    lcdtris.data = 0xF; 
....................   #endif 
....................  #endif 
....................          
....................    lcd_output_rw(1); 
010E:  BSF    F8B.0
0110:  BCF    F94.0
....................    delay_cycles(1); 
0112:  NOP   
....................    lcd_output_enable(1); 
0114:  BSF    F8A.3
0116:  BCF    F93.3
....................    delay_cycles(1); 
0118:  NOP   
....................    high = lcd_read_nibble(); 
011A:  RCALL  00B4
011C:  MOVFF  01,2B
....................        
....................    lcd_output_enable(0); 
0120:  BCF    F8A.3
0122:  BCF    F93.3
....................    delay_cycles(1); 
0124:  NOP   
....................    lcd_output_enable(1); 
0126:  BSF    F8A.3
0128:  BCF    F93.3
....................    delay_us(1); 
012A:  BRA    012C
012C:  BRA    012E
012E:  NOP   
....................    low = lcd_read_nibble(); 
0130:  RCALL  00B4
0132:  MOVFF  01,2A
....................        
....................    lcd_output_enable(0); 
0136:  BCF    F8A.3
0138:  BCF    F93.3
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_drive(LCD_DATA4); 
013A:  BCF    F93.4
....................    output_drive(LCD_DATA5); 
013C:  BCF    F93.5
....................    output_drive(LCD_DATA6); 
013E:  BCF    F93.6
....................    output_drive(LCD_DATA7); 
0140:  BCF    F93.7
....................   #else 
....................    lcdtris.data = 0x0; 
....................   #endif 
....................  #endif 
....................  
....................    return( (high<<4) | low); 
0142:  SWAPF  2B,W
0144:  MOVWF  00
0146:  MOVLW  F0
0148:  ANDWF  00,F
014A:  MOVF   00,W
014C:  IORWF  2A,W
014E:  MOVWF  01
0150:  GOTO   0160 (RETURN)
.................... } 
....................  
.................... unsigned int8 lcd_read_nibble(void) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
*
00B4:  CLRF   2C
....................    unsigned int8 n = 0x00; 
....................  
....................    /* Read the data port */ 
....................    n |= input(LCD_DATA4); 
00B6:  BSF    F93.4
00B8:  MOVLW  00
00BA:  BTFSC  F81.4
00BC:  MOVLW  01
00BE:  IORWF  2C,F
....................    n |= input(LCD_DATA5) << 1; 
00C0:  BSF    F93.5
00C2:  MOVLW  00
00C4:  BTFSC  F81.5
00C6:  MOVLW  01
00C8:  MOVWF  00
00CA:  BCF    FD8.0
00CC:  RLCF   00,F
00CE:  MOVF   00,W
00D0:  IORWF  2C,F
....................    n |= input(LCD_DATA6) << 2; 
00D2:  BSF    F93.6
00D4:  MOVLW  00
00D6:  BTFSC  F81.6
00D8:  MOVLW  01
00DA:  MOVWF  00
00DC:  RLCF   00,F
00DE:  RLCF   00,F
00E0:  MOVLW  FC
00E2:  ANDWF  00,F
00E4:  MOVF   00,W
00E6:  IORWF  2C,F
....................    n |= input(LCD_DATA7) << 3; 
00E8:  BSF    F93.7
00EA:  MOVLW  00
00EC:  BTFSC  F81.7
00EE:  MOVLW  01
00F0:  MOVWF  00
00F2:  RLCF   00,F
00F4:  RLCF   00,F
00F6:  RLCF   00,F
00F8:  MOVLW  F8
00FA:  ANDWF  00,F
00FC:  MOVF   00,W
00FE:  IORWF  2C,F
....................     
....................    return(n); 
0100:  MOVFF  2C,01
....................   #else 
0104:  RETURN 0
....................    return(lcd.data); 
....................   #endif 
.................... } 
....................  
.................... void lcd_send_nibble(unsigned int8 n) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    /* Write to the data port */ 
....................    output_bit(LCD_DATA4, bit_test(n, 0)); 
*
0070:  BTFSC  2B.0
0072:  BRA    0078
0074:  BCF    F8A.4
0076:  BRA    007A
0078:  BSF    F8A.4
007A:  BCF    F93.4
....................    output_bit(LCD_DATA5, bit_test(n, 1)); 
007C:  BTFSC  2B.1
007E:  BRA    0084
0080:  BCF    F8A.5
0082:  BRA    0086
0084:  BSF    F8A.5
0086:  BCF    F93.5
....................    output_bit(LCD_DATA6, bit_test(n, 2)); 
0088:  BTFSC  2B.2
008A:  BRA    0090
008C:  BCF    F8A.6
008E:  BRA    0092
0090:  BSF    F8A.6
0092:  BCF    F93.6
....................    output_bit(LCD_DATA7, bit_test(n, 3)); 
0094:  BTFSC  2B.3
0096:  BRA    009C
0098:  BCF    F8A.7
009A:  BRA    009E
009C:  BSF    F8A.7
009E:  BCF    F93.7
....................   #else       
....................    lcdlat.data = n; 
....................   #endif 
....................        
....................    delay_cycles(1); 
00A0:  NOP   
....................    lcd_output_enable(1); 
00A2:  BSF    F8A.3
00A4:  BCF    F93.3
....................    delay_us(2); 
00A6:  MOVLW  03
00A8:  MOVWF  00
00AA:  DECFSZ 00,F
00AC:  BRA    00AA
....................    lcd_output_enable(0); 
00AE:  BCF    F8A.3
00B0:  BCF    F93.3
00B2:  RETURN 0
.................... } 
....................  
.................... void lcd_send_byte(unsigned int8 address, unsigned int8 n) 
.................... { 
....................   #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................   #else 
....................    lcd_enable_tris(); 
*
0154:  BCF    F93.3
....................    lcd_rs_tris(); 
0156:  BCF    F93.2
....................    lcd_rw_tris(); 
0158:  BCF    F94.0
....................   #endif 
....................  
....................    lcd_output_rs(0); 
015A:  BCF    F8A.2
015C:  BCF    F93.2
....................    while ( bit_test(lcd_read_byte(),7) ) ; 
015E:  BRA    0106
0160:  MOVFF  01,2A
0164:  BTFSC  01.7
0166:  BRA    015E
....................    lcd_output_rs(address); 
0168:  MOVF   28,F
016A:  BNZ   0170
016C:  BCF    F8A.2
016E:  BRA    0172
0170:  BSF    F8A.2
0172:  BCF    F93.2
....................    delay_cycles(1); 
0174:  NOP   
....................    lcd_output_rw(0); 
0176:  BCF    F8B.0
0178:  BCF    F94.0
....................    delay_cycles(1); 
017A:  NOP   
....................    lcd_output_enable(0); 
017C:  BCF    F8A.3
017E:  BCF    F93.3
....................    lcd_send_nibble(n >> 4); 
0180:  SWAPF  29,W
0182:  MOVWF  2A
0184:  MOVLW  0F
0186:  ANDWF  2A,F
0188:  MOVFF  2A,2B
018C:  RCALL  0070
....................    lcd_send_nibble(n & 0xf); 
018E:  MOVF   29,W
0190:  ANDLW  0F
0192:  MOVWF  2A
0194:  MOVWF  2B
0196:  RCALL  0070
0198:  RETURN 0
.................... } 
....................  
.................... #if defined(LCD_EXTENDED_NEWLINE) 
.................... unsigned int8 g_LcdX, g_LcdY; 
.................... #endif 
....................  
.................... void lcd_init(void)  
.................... { 
....................    unsigned int8 i; 
....................    unsigned int8 LCD_INIT_STRING[4] = {0x20 | (LCD_TYPE << 2), 0xc, 1, 6}; 
019A:  MOVLW  28
019C:  MOVWF  17
019E:  MOVLW  0C
01A0:  MOVWF  18
01A2:  MOVLW  01
01A4:  MOVWF  19
01A6:  MOVLW  06
01A8:  MOVWF  1A
....................                              // These bytes need to be sent to the LCD 
....................                              // to start it up. 
....................     
....................  
....................    lcd_output_enable(0); 
01AA:  BCF    F8A.3
01AC:  BCF    F93.3
....................    lcd_output_rs(0); 
01AE:  BCF    F8A.2
01B0:  BCF    F93.2
....................    lcd_output_rw(0); 
01B2:  BCF    F8B.0
01B4:  BCF    F94.0
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_drive(LCD_DATA4); 
01B6:  BCF    F93.4
....................    output_drive(LCD_DATA5); 
01B8:  BCF    F93.5
....................    output_drive(LCD_DATA6); 
01BA:  BCF    F93.6
....................    output_drive(LCD_DATA7); 
01BC:  BCF    F93.7
....................   #else 
....................    lcdtris.data = 0x0; 
....................   #endif 
....................    lcd_enable_tris(); 
01BE:  BCF    F93.3
....................    lcd_rs_tris(); 
01C0:  BCF    F93.2
....................    lcd_rw_tris(); 
01C2:  BCF    F94.0
....................  #endif 
....................      
....................    delay_ms(15); 
01C4:  MOVLW  0F
01C6:  MOVWF  2E
01C8:  RCALL  004A
....................    for(i=1;i<=3;++i) 
01CA:  MOVLW  01
01CC:  MOVWF  16
01CE:  MOVF   16,W
01D0:  SUBLW  03
01D2:  BNC   01E4
....................    { 
....................        lcd_send_nibble(3); 
01D4:  MOVLW  03
01D6:  MOVWF  2B
01D8:  RCALL  0070
....................        delay_ms(5); 
01DA:  MOVLW  05
01DC:  MOVWF  2E
01DE:  RCALL  004A
01E0:  INCF   16,F
01E2:  BRA    01CE
....................    } 
....................     
....................    lcd_send_nibble(2); 
01E4:  MOVLW  02
01E6:  MOVWF  2B
01E8:  RCALL  0070
....................    delay_ms(5); 
01EA:  MOVLW  05
01EC:  MOVWF  2E
01EE:  RCALL  004A
....................    for(i=0;i<=3;++i) 
01F0:  CLRF   16
01F2:  MOVF   16,W
01F4:  SUBLW  03
01F6:  BNC   0212
....................       lcd_send_byte(0,LCD_INIT_STRING[i]); 
01F8:  CLRF   03
01FA:  MOVF   16,W
01FC:  ADDLW  17
01FE:  MOVWF  FE9
0200:  MOVLW  00
0202:  ADDWFC 03,W
0204:  MOVWF  FEA
0206:  MOVFF  FEF,29
020A:  CLRF   28
020C:  RCALL  0154
....................  
....................   #if defined(LCD_EXTENDED_NEWLINE) 
020E:  INCF   16,F
0210:  BRA    01F2
0212:  GOTO   125E (RETURN)
....................    g_LcdX = 0; 
....................    g_LcdY = 0; 
....................   #endif 
.................... } 
....................  
.................... void lcd_gotoxy(unsigned int8 x, unsigned int8 y) 
.................... { 
....................    unsigned int8 address; 
....................     
....................    if(y!=1) 
0216:  DECFSZ 25,W
0218:  BRA    021C
021A:  BRA    0222
....................       address=LCD_LINE_TWO; 
021C:  MOVLW  40
021E:  MOVWF  26
0220:  BRA    0224
....................    else 
....................       address=0; 
0222:  CLRF   26
....................       
....................    address+=x-1; 
0224:  MOVLW  01
0226:  SUBWF  24,W
0228:  ADDWF  26,F
....................    lcd_send_byte(0,0x80|address); 
022A:  MOVF   26,W
022C:  IORLW  80
022E:  MOVWF  27
0230:  CLRF   28
0232:  MOVWF  29
0234:  RCALL  0154
....................  
....................   #if defined(LCD_EXTENDED_NEWLINE) 
0236:  RETURN 0
....................    g_LcdX = x - 1; 
....................    g_LcdY = y - 1; 
....................   #endif 
.................... } 
....................  
.................... void lcd_putc(char c) 
.................... { 
....................    switch (c) 
0238:  MOVF   23,W
023A:  XORLW  07
023C:  BZ    024C
023E:  XORLW  0B
0240:  BZ    0256
0242:  XORLW  06
0244:  BZ    0266
0246:  XORLW  02
0248:  BZ    0272
024A:  BRA    027C
....................    { 
....................       case '\a'   :  lcd_gotoxy(1,1);     break; 
024C:  MOVLW  01
024E:  MOVWF  24
0250:  MOVWF  25
0252:  RCALL  0216
0254:  BRA    0286
....................  
....................       case '\f'   :  lcd_send_byte(0,1); 
0256:  CLRF   28
0258:  MOVLW  01
025A:  MOVWF  29
025C:  RCALL  0154
....................                      delay_ms(2); 
025E:  MOVLW  02
0260:  MOVWF  2E
0262:  RCALL  004A
....................                     #if defined(LCD_EXTENDED_NEWLINE) 
....................                      g_LcdX = 0; 
....................                      g_LcdY = 0; 
....................                     #endif 
....................                      break; 
0264:  BRA    0286
....................  
....................      #if defined(LCD_EXTENDED_NEWLINE) 
....................       case '\r'   :  lcd_gotoxy(1, g_LcdY+1);   break; 
....................       case '\n'   : 
....................          while (g_LcdX++ < LCD_LINE_LENGTH) 
....................          { 
....................             lcd_send_byte(1, ' '); 
....................          } 
....................          lcd_gotoxy(1, g_LcdY+2); 
....................          break; 
....................      #else 
....................       case '\n'   : lcd_gotoxy(1,2);        break; 
0266:  MOVLW  01
0268:  MOVWF  24
026A:  MOVLW  02
026C:  MOVWF  25
026E:  RCALL  0216
0270:  BRA    0286
....................      #endif 
....................       
....................       case '\b'   : lcd_send_byte(0,0x10);  break; 
0272:  CLRF   28
0274:  MOVLW  10
0276:  MOVWF  29
0278:  RCALL  0154
027A:  BRA    0286
....................       
....................      #if defined(LCD_EXTENDED_NEWLINE) 
....................       default     :  
....................          if (g_LcdX < LCD_LINE_LENGTH) 
....................          { 
....................             lcd_send_byte(1, c); 
....................             g_LcdX++; 
....................          } 
....................          break; 
....................      #else 
....................       default     : lcd_send_byte(1,c);     break; 
027C:  MOVLW  01
027E:  MOVWF  28
0280:  MOVFF  23,29
0284:  RCALL  0154
....................      #endif 
....................    } 
0286:  RETURN 0
.................... } 
....................   
.................... char lcd_getc(unsigned int8 x, unsigned int8 y) 
.................... { 
....................    char value; 
....................  
....................    lcd_gotoxy(x,y); 
....................    while ( bit_test(lcd_read_byte(),7) ); // wait until busy flag is low 
....................    lcd_output_rs(1); 
....................    value = lcd_read_byte(); 
....................    lcd_output_rs(0); 
....................     
....................    return(value); 
.................... } 
....................  
.................... // write a custom character to the ram 
.................... // which is 0-7 and specifies which character array we are modifying. 
.................... // ptr points to an array of 8 bytes, where each byte is the next row of 
.................... //    pixels.  only bits 0-4 are used.  the last row is the cursor row, and 
.................... //    usually you will want to leave this byte 0x00. 
.................... void lcd_set_cgram_char(unsigned int8 which, unsigned int8 *ptr) 
.................... { 
....................    unsigned int i; 
....................  
....................    which <<= 3; 
....................    which &= 0x38; 
....................  
....................    lcd_send_byte(0, 0x40 | which);  //set cgram address 
....................  
....................    for(i=0; i<8; i++) 
....................    { 
....................       lcd_send_byte(1, *ptr++); 
....................    } 
....................    
....................    #if defined(LCD_EXTENDED_NEWLINE) 
....................     lcd_gotoxy(g_LcdX+1, g_LcdY+1);  //set ddram address 
....................    #endif 
.................... } 
....................  
.................... void lcd_cursor_on(int1 on) 
.................... { 
....................    if (on) 
....................    { 
....................       lcd_send_byte(0,0x0F);           //turn LCD cursor ON 
....................    } 
....................    else 
....................    { 
....................       lcd_send_byte(0,0x0C);           //turn LCD cursor OFF 
....................    } 
.................... } 
....................  
.................... #endif 
....................  
....................  
.................... // --- Sensör I2C Adresleri (8-Bit Format) --- 
.................... #define ENS160_ADDR_W   0xA6  // 0x53 << 1 (Yazma) 
.................... #define ENS160_ADDR_R   0xA7  // (0x53 << 1) | 1 (Okuma) 
....................  
.................... #define BME688_ADDR_W   0xEE  // 0x77 << 1 (Yazma) 
.................... #define BME688_ADDR_R   0xEF  // (0x77 << 1) | 1 (Okuma) 
....................  
.................... // --- ENS160 Register Adresleri --- 
.................... #define ENS160_REG_OPMODE      0x10 
.................... #define ENS160_REG_DATA_AQI    0x21 
.................... #define ENS160_REG_DATA_TVOC   0x22 
.................... #define ENS160_REG_DATA_ECO2   0x24 
.................... #define ENS160_OPMODE_STD      0x02 // Standart Ölçüm Modu 
....................  
.................... // --- BME688 Register Adresleri --- 
.................... #define BME688_REG_CTRL_HUM    0x72 
.................... #define BME688_REG_CTRL_MEAS   0x74 
.................... #define BME688_REG_TEMP_MSB    0x22 
.................... #define BME688_REG_PRESS_MSB   0x1F 
.................... #define BME688_REG_HUM_MSB     0x25 
....................  
.................... // Global Değişkenler 
.................... unsigned int8  aqi = 0; 
.................... unsigned int16 tvoc = 0; 
.................... unsigned int16 eco2 = 0; 
....................  
.................... unsigned int16 par_t1; 
.................... signed int16   par_t2; 
.................... signed int8    par_t3; 
.................... float          bme_temp = 0.0; 
.................... unsigned int16 bme_hum_raw = 0; 
....................  
.................... // --- Genel I2C Yazma Fonksiyonu --- 
.................... void i2c_write_reg(unsigned int8 dev_addr, unsigned int8 reg_addr, unsigned int8 data) { 
....................    i2c_start(); 
*
02F0:  BSF    F93.0
02F2:  NOP   
02F4:  BSF    F93.1
02F6:  NOP   
02F8:  BCF    F8A.0
02FA:  BCF    F93.0
02FC:  NOP   
02FE:  BCF    F8A.1
0300:  BCF    F93.1
....................    i2c_write(dev_addr); 
0302:  MOVFF  2E,35
0306:  RCALL  02A8
....................    i2c_write(reg_addr); 
0308:  MOVFF  2F,35
030C:  RCALL  02A8
....................    i2c_write(data); 
030E:  MOVFF  30,35
0312:  RCALL  02A8
....................    i2c_stop(); 
0314:  BCF    F93.0
0316:  NOP   
0318:  BSF    F93.1
031A:  BTFSS  F81.1
031C:  BRA    031A
031E:  NOP   
0320:  BRA    0322
0322:  NOP   
0324:  BSF    F93.0
0326:  NOP   
0328:  RETURN 0
.................... } 
....................  
.................... // --- Genel I2C Çoklu Byte Okuma Fonksiyonu --- 
.................... void i2c_read_bytes(unsigned int8 dev_addr_w, unsigned int8 reg_addr, unsigned int8 *buffer, unsigned int8 len) { 
....................    unsigned int8 i; 
....................    i2c_start(); 
*
0390:  BSF    F93.0
0392:  NOP   
0394:  BSF    F93.1
0396:  NOP   
0398:  BCF    F8A.0
039A:  BCF    F93.0
039C:  NOP   
039E:  BCF    F8A.1
03A0:  BCF    F93.1
....................    i2c_write(dev_addr_w); 
03A2:  MOVFF  2E,35
03A6:  RCALL  02A8
....................    i2c_write(reg_addr); 
03A8:  MOVFF  2F,35
03AC:  RCALL  02A8
....................    i2c_start(); // Repeated Start 
03AE:  BSF    F93.0
03B0:  NOP   
03B2:  BSF    F93.1
03B4:  NOP   
03B6:  BTFSS  F81.1
03B8:  BRA    03B6
03BA:  BCF    F8A.0
03BC:  BCF    F93.0
03BE:  NOP   
03C0:  BCF    F8A.1
03C2:  BCF    F93.1
....................    i2c_write(dev_addr_w | 0x01); 
03C4:  MOVF   2E,W
03C6:  IORLW  01
03C8:  MOVWF  34
03CA:  MOVWF  35
03CC:  RCALL  02A8
....................    for(i = 0; i < len; i++) { 
03CE:  CLRF   33
03D0:  MOVF   32,W
03D2:  SUBWF  33,W
03D4:  BC    040E
....................       if(i == (len - 1)) 
03D6:  MOVLW  01
03D8:  SUBWF  32,W
03DA:  SUBWF  33,W
03DC:  BNZ   03F4
....................          buffer[i] = i2c_read(0); // Son byte için NACK 
03DE:  MOVF   33,W
03E0:  ADDWF  30,W
03E2:  MOVWF  FE9
03E4:  MOVLW  00
03E6:  ADDWFC 31,W
03E8:  MOVWF  FEA
03EA:  CLRF   00
03EC:  RCALL  0348
03EE:  MOVFF  01,FEF
03F2:  BRA    040A
....................       else 
....................          buffer[i] = i2c_read(1); // ACK 
03F4:  MOVF   33,W
03F6:  ADDWF  30,W
03F8:  MOVWF  FE9
03FA:  MOVLW  00
03FC:  ADDWFC 31,W
03FE:  MOVWF  FEA
0400:  MOVLW  01
0402:  MOVWF  00
0404:  RCALL  0348
0406:  MOVFF  01,FEF
040A:  INCF   33,F
040C:  BRA    03D0
....................    } 
....................    i2c_stop(); 
040E:  BCF    F93.0
0410:  NOP   
0412:  BSF    F93.1
0414:  BTFSS  F81.1
0416:  BRA    0414
0418:  NOP   
041A:  BRA    041C
041C:  NOP   
041E:  BSF    F93.0
0420:  NOP   
0422:  RETURN 0
.................... } 
